{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.Title }}{{ if not .IsHome }} — {{ .Title }}{{ end }}</title><link>{{ .Permalink }}</link><description>Notes and writing by Sumeet Naik.</description><language>en</language><atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
{{ $pages := where site.RegularPages "Section" "in" (slice "notes" "blog") }}{{ if not .IsHome }}{{ $pages = .RegularPages }}{{ end }}{{ range first 30 $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Description | default .Summary | plainify | htmlUnescape | truncate 240 }}</description></item>{{ end }}</channel></rss>
